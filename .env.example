# REDOLIO — copy this file to .env, then run:   php artisan key:generate
# NEVER commit your real .env (it is git-ignored). Every key below is optional unless marked REQUIRED.

APP_NAME=REDOLIO
APP_ENV=local
# REQUIRED — filled in by `php artisan key:generate`
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: MySQL 8 (MariaDB 10.6+ works too) ---
# Create an empty database first:  mysql -u root -p -e "CREATE DATABASE redolio CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
# then set the name and login below. (To just try the app with SQLite: DB_CONNECTION=sqlite, remove the other DB_* lines,
# and run `touch database/database.sqlite`.)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Edition ---
# "selfhosted": your own installation — no plans or billing, unlimited use, you are the admin.
# "saas":       a hosted multi-user service with Free / Starter / Agency plans (Stripe optional, below).
REDO_EDITION=selfhosted

# --- First admin (created by `php artisan migrate --seed`) ---
# Set both to choose your own login. Leave them empty and a random password is created and shown once in the console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI: Meta Model API (the default provider) ---
# Easiest: leave these empty and, after signing in as admin, open Admin -> Settings -> Meta Model API and paste your key.
# (The base URL and model are pre-filled there.) Or set them here. Your key is NEVER stored in the source code.
META_API_BASE_URL=https://api.meta.ai/v1
META_API_MODEL_ID=muse-spark-1.3
META_API_KEY=
META_API_TIMEOUT_SECONDS=90
META_API_MAX_ATTEMPTS=3

# Active provider: meta | claude | openai | gemini  (switchable in Admin -> Settings)
AI_PROVIDER=meta
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Mail (the default just writes emails to the log) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where "email us" links in the product point (404 page, export instructions)
REDO_SUPPORT_EMAIL=hello@example.com

# --- Website crawler ---
CRAWLER_MAX_PAGES=8
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_TEXT_CHARS=50000
CRAWLER_USER_AGENT="REDOLIO Website Analysis Bot"

# --- Browser for screenshots and visual checks ---
# "local": Chromium on this machine (npm install, then `npx playwright install chromium`).
# "browserbase" or "browserless": a cloud browser (needed on shared hosting). REDO_BROWSER_FALLBACK is the backup if the first fails.
REDO_BROWSER_PROVIDER=local
REDO_BROWSER_FALLBACK=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERLESS_API_KEY=
BROWSERLESS_URL=https://production-sfo.browserless.io
# Full path to Node.js if the web/queue user cannot find it, e.g. /usr/bin/node
REDO_NODE_BINARY=node

# --- Optional integrations (each feature hides itself until its key exists) ---
# free stock-photo fallback
PEXELS_API_KEY=
# photo search in the editor
UNSPLASH_ACCESS_KEY=
# "Continue with Google" (Web client ID, no secret needed)
GOOGLE_CLIENT_ID=
# visitor country/city in Admin -> Analytics (no IP addresses are stored)
GEOIP_ENABLED=true
HERO_AUTO_APPLY=true

# --- Stripe billing (saas edition only) ---
# Webhook endpoint: {APP_URL}/stripe/webhook   Events: checkout.session.completed, invoice.paid,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_REDOLIO_STARTER_PRICE_ID=
STRIPE_REDOLIO_AGENCY_PRICE_ID=
STRIPE_REDOLIO_EXPORT_PRICE_ID=
STRIPE_REDOLIO_EXPORT_OFFER_PRICE_ID=

VITE_APP_NAME="${APP_NAME}"
