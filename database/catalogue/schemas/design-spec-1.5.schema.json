{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redoweb.site/schemas/design-spec-1.5.schema.json",
  "title": "REDO DesignSpec 1.5 (blueprint block)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "brand", "design", "pages", "content_mapping", "responsive", "seo", "forms", "provenance", "validation"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.5"] },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "source_url", "business_name", "business_category", "primary_goal"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https?://" },
        "business_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "business_category": { "type": ["string", "null"] },
        "primary_goal": { "type": "string", "enum": ["lead", "booking", "purchase", "inquiry", "awareness"] }
      }
    },
    "brand": {
      "type": "object", "additionalProperties": false,
      "required": ["brand_summary", "brand_voice", "logo_asset_id", "brand_colours", "brand_continuity_policy"],
      "properties": {
        "brand_summary": { "type": ["string", "null"], "maxLength": 600 },
        "brand_voice": { "type": "array", "items": { "type": "string", "maxLength": 60 } },
        "logo_asset_id": { "type": ["string", "null"] },
        "brand_colours": { "type": "object" },
        "brand_continuity_policy": { "type": "string", "enum": ["preserve-logo-and-wording", "preserve-logo", "preserve-wording", "free"] }
      }
    },
    "design": {
      "type": "object", "additionalProperties": false,
      "required": ["category_id", "direction_id", "direction_version", "blueprint_id", "blueprint_version", "token_profile_id", "token_overrides", "catalogue_version"],
      "properties": {
        "category_id": { "type": ["string", "null"] },
        "direction_id": { "type": "string", "minLength": 1 },
        "direction_version": { "type": "integer", "minimum": 1 },
        "blueprint_id": { "type": "string", "minLength": 1 },
        "blueprint_version": { "type": "integer", "minimum": 1 },
        "token_profile_id": { "type": "string", "minLength": 1 },
        "token_overrides": { "type": ["object", "array"] },
        "catalogue_version": { "type": "string" }
      }
    },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route", "page_title", "meta_description", "sections"],
        "properties": {
          "route": { "type": "string", "pattern": "^/[a-z0-9\\-/]*$" },
          "page_title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "meta_description": { "type": ["string", "null"], "maxLength": 200 },
          "widgets": { "type": "array", "maxItems": 14 },
          "sections": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["instance_id", "component_id", "variant_id", "content_bindings", "asset_bindings", "props"],
              "properties": {
                "instance_id": { "type": "string", "pattern": "^[a-z0-9\\-]+$" },
                "component_id": { "type": "string", "pattern": "^[a-z\\-]+$" },
                "variant_id": { "type": "string", "pattern": "^[a-z\\-]+$" },
                "content_bindings": { "type": "object" },
                "asset_bindings": { "type": "array", "items": { "type": "object", "required": ["slot", "asset_id"], "properties": { "slot": { "type": "string" }, "asset_id": { "type": "string" } } } },
                "overrides": { "type": "object" },
                "props": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "content_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_slots_complete", "omitted_sections"],
      "properties": {
        "status": { "type": "string", "enum": ["complete", "partial"] },
        "required_slots_complete": { "type": "boolean" },
        "omitted_sections": {
          "type": "array",
          "items": { "type": "object", "required": ["instance_id", "required", "reason"], "properties": { "instance_id": { "type": "string" }, "required": { "type": "boolean" }, "reason": { "type": "string" } } }
        }
      }
    },
    "responsive": {
      "type": "object", "additionalProperties": false,
      "required": ["breakpoint_profile", "mobile_navigation", "section_order_overrides", "visibility_rules"],
      "properties": {
        "breakpoint_profile": { "type": "string", "enum": ["default"] },
        "mobile_navigation": { "type": "string", "enum": ["disclosure-menu"] },
        "section_order_overrides": { "type": ["object", "array"] },
        "visibility_rules": { "type": ["object", "array"] }
      }
    },
    "seo": {
      "type": "object", "additionalProperties": false,
      "required": ["title_template", "canonical_policy", "open_graph", "structured_data_policy"],
      "properties": {
        "title_template": { "type": "string" },
        "canonical_policy": { "type": "string", "enum": ["self"] },
        "open_graph": { "type": "object" },
        "structured_data_policy": { "type": "string", "enum": ["organization-verified-facts-only"] }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["form_id", "fields", "validation_schema_id", "submission_adapter"],
        "properties": {
          "form_id": { "type": "string" },
          "fields": { "type": "array", "minItems": 1 },
          "validation_schema_id": { "type": "string" },
          "submission_adapter": { "type": "string", "enum": ["mailto"] }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["content_evidence_ids", "asset_source_ids", "model_run_ids"],
      "properties": {
        "content_evidence_ids": { "type": "array", "items": { "type": "string" } },
        "asset_source_ids": { "type": "array", "items": { "type": "string" } },
        "model_run_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_valid", "registry_valid", "content_integrity_valid", "asset_integrity_valid"],
      "properties": {
        "schema_valid": { "type": "boolean" }, "registry_valid": { "type": "boolean" },
        "content_integrity_valid": { "type": "boolean" }, "asset_integrity_valid": { "type": "boolean" }
      }
    }
  }
}
